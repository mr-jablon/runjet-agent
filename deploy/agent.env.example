# Reference for /etc/runjet-agent/agent.env.
#
# `runjet-agent enroll` writes that file itself, with the first three
# settings filled in and mode 0600 — this is here for the optional ones below,
# and for anyone who would rather write it by hand.

# Where the scheduler lives. Use https in anything but a local setup: the
# signature on a dispatch proves who sent it, but only TLS keeps the command
# and its output private on the way.
RUNJET_URL=https://runjet.dev

# The scheduler keys this agent will accept, as id:base64. Commands carrying
# anything else are refused rather than run. List several during a key
# rotation, comma separated.
RUNJET_PUBLIC_KEYS=sched-1:REPLACE_WITH_THE_KEY_FROM_THE_UI

# Must match the name the agent was registered under.
AGENT_NAME=web-01

# There is deliberately no ENROLLMENT_TOKEN here. `enroll` spends it as it runs
# and never writes it down, so nothing is left to remember to delete. Writing
# this file by hand instead? Add the token, start the agent once, then remove
# the line — it is burned on first use and only a liability afterwards.

# Provided by systemd's StateDirectory. Holds the private key, mode 0600.
AGENT_STATE_DIR=/var/lib/runjet-agent

# Optional. KEY=value lines, mode 0600, holding the secrets jobs on this host
# need. A job names what it wants and the agent supplies the value, so the
# scheduler never sees it. Values are read literally, so a secret may contain
# spaces. Falls back to this service's own environment when the file is unset.
#AGENT_SECRETS_FILE=/etc/runjet-agent/secrets

# Optional. Variables from this file that job commands should also receive.
#
# A job does not inherit the agent's environment: it gets a fixed base (PATH,
# HOME, USER, LOGNAME, SHELL, TZ, LANG, LC_*) plus the secrets it asked for,
# and nothing else — which is what keeps the settings above out of every
# command this agent runs. Anything else a job needs has to be named here.
#
# Exact names, comma separated. A pattern like AWS_* is refused rather than
# quietly matching nothing, and so is any setting from this file: forwarding
# one would hand jobs exactly what the boundary exists to keep from them.
#AGENT_PASS_ENV=JAVA_HOME,HTTPS_PROXY,NO_PROXY

# How many different jobs may run at once on this host. The same job never
# overlaps itself regardless.
#AGENT_MAX_PARALLEL=4

# How long a poll waits for work before reconnecting. Longer means fewer
# requests; anything up to 60s is accepted.
#AGENT_POLL_WAIT=30s

# The account job commands run as. Jobs must not share the agent's user: as
# long as they do, `cat` gives them its private key and this file. The
# packaging creates this account; unset, it defaults to runjet-job.
#
# A numeric id works where the account exists only in a directory (LDAP, SSSD)
# — the agent is a static binary and reads /etc/passwd itself — and then
# AGENT_JOB_GROUP has to give the group id too.
#
# Set it empty to run jobs as the agent, accepting what that costs. The agent
# warns at every start when you do.
#AGENT_JOB_USER=runjet-job
#AGENT_JOB_GROUP=
